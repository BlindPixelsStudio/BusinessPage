---
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Privacy Policy - See My Eyes | Blind Pixels Studio</title>
		<meta name="description" content="Privacy policy for See My Eyes iOS app by Blind Pixels Studio." />
	</head>
	<body class="page">
		<Nav />
		<div class="layout">
			<main id="main-content">
				<header class="page-header">
					<h1>Privacy Policy</h1>
					<p class="subtitle">See My Eyes</p>
				</header>

				<section class="content-section">
					<p class="last-updated">Last updated: November 17, {currentYear}</p>

					<h2>Overview</h2>
					<p>
						See My Eyes is designed with your privacy in mind. This app helps people with low vision follow cursors 
						in screen-shares and videos by providing visual enhancements. We are committed to protecting your privacy 
						and being transparent about our practices.
					</p>

					<h2>Information We Collect</h2>
					<h3>Information You Don't Provide</h3>
					<p>
						<strong>See My Eyes does not collect, store, or transmit any personal information.</strong> The app:
					</p>
					<ul>
						<li>Does not require you to create an account</li>
						<li>Does not collect your name, email, or contact information</li>
						<li>Does not track your location</li>
						<li>Does not access your camera, microphone, or photos</li>
						<li>Does not collect device identifiers or advertising IDs</li>
					</ul>

					<h3>Usage Data</h3>
					<p>
						The app processes screen content and cursor positions locally on your device to provide visual enhancements. 
						This processing happens entirely on your device and is not transmitted, stored, or shared with anyone.
					</p>

					<h2>Third-Party Services</h2>
					<p>
						See My Eyes does not integrate with any third-party analytics, advertising, or tracking services. 
						The app operates entirely offline and independently on your device.
					</p>

					<h2>Data Security</h2>
					<p>
						Since no data leaves your device, your information remains secure on your iOS device, protected by 
						Apple's built-in security features and your device's passcode or biometric authentication.
					</p>

					<h2>Children's Privacy</h2>
					<p>
						See My Eyes does not knowingly collect information from anyone, including children under 13. 
						The app is safe for all ages as it does not collect or transmit any personal data.
					</p>

					<h2>Changes to This Policy</h2>
					<p>
						If we make changes to this privacy policy, we will update the "Last updated" date at the top of this page. 
						We will also notify users through the App Store update notes if there are significant changes to our privacy practices.
					</p>

					<h2>Contact Us</h2>
					<p>
						If you have questions about this privacy policy or See My Eyes, please contact us at:
					</p>
					<p>
						<strong>Email:</strong> <a href="mailto:support@blindpixelsstudio.com">support@blindpixelsstudio.com</a>
					</p>
				</section>
			</main>
		</div>
		<Footer />
	</body>
	<style lang="css">
		.layout {
			width: min(1080px, 100% - 3rem);
			margin: 0 auto;
			padding: 4rem 0 6.25rem;
		}

		.page-header {
			margin-bottom: 3rem;
		}

		.page-header h1 {
			font-size: 3rem;
			font-weight: 700;
			margin: 0 0 0.5rem;
			background: linear-gradient(120deg, #f1f5ff, #93c5fd);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
		}

		.subtitle {
			font-size: 1.5rem;
			color: #93c5fd;
			margin: 0;
		}

		.content-section {
			background: rgba(20, 33, 61, 0.4);
			border: 1px solid rgba(147, 197, 253, 0.1);
			border-radius: 1rem;
			padding: 2.5rem;
			line-height: 1.7;
		}

		.last-updated {
			color: #94a3b8;
			font-size: 0.95rem;
			margin-top: 0;
			font-style: italic;
		}

		.content-section h2 {
			color: #f1f5ff;
			font-size: 1.75rem;
			margin: 2.5rem 0 1rem;
		}

		.content-section h2:first-of-type {
			margin-top: 1.5rem;
		}

		.content-section h3 {
			color: #93c5fd;
			font-size: 1.25rem;
			margin: 1.5rem 0 0.75rem;
		}

		.content-section p {
			margin: 1rem 0;
			color: #cbd5e1;
		}

		.content-section ul {
			margin: 1rem 0;
			padding-left: 1.5rem;
		}

		.content-section li {
			margin: 0.5rem 0;
			color: #cbd5e1;
		}

		.content-section a {
			color: #93c5fd;
			text-decoration: underline;
			transition: color 0.2s ease;
		}

		.content-section a:hover,
		.content-section a:focus {
			color: #60a5fa;
		}

		.content-section strong {
			color: #f1f5ff;
		}

		@media (max-width: 768px) {
			.page-header h1 {
				font-size: 2.25rem;
			}

			.subtitle {
				font-size: 1.25rem;
			}

			.content-section {
				padding: 1.5rem;
			}

			.content-section h2 {
				font-size: 1.5rem;
			}

			.content-section h3 {
				font-size: 1.125rem;
			}
		}
	</style>
</html>
