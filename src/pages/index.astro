---
const apps = [
	{
		id: "see-my-eyes",
		title: "See My Eyes",
		description:
			"An accessibility app that helps people with low vision follow cursors in screen-shares and videos.",
		primary: {
			href: "/see-my-eyes",
			label: "Learn more",
		},
		secondary: {
			href: "/privacy/see-my-eyes",
			label: "Privacy Policy",
		},
	},
	{
		id: "ai-board-game-rules",
		title: "AI Board Game Rules",
		description: "A web app that answers board game rule questions in plain language.",
		primary: {
			href: "https://www.boardgamerules.ai",
			label: "Open app",
		},
		secondary: {
			href: "/privacy/ai-board-game-rules",
			label: "Privacy Policy",
		},
	},
	{
		id: "video-cursor-tracker",
		title: "Video Cursor Tracker",
		description:
			"A desktop tool that highlights the cursor in videos so it's easier to see during tutorials, meetings, and recordings.",
		primary: {
			href: "/video-cursor-tracker",
			label: "Learn more",
		},
		secondary: {
			href: "/privacy/video-cursor-tracker",
			label: "Privacy Policy",
		},
	},
];
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Blind Pixels Studio crafts accessibility-focused apps and tools." />
		<title>Blind Pixels Studio</title>
	</head>
	<body class="page">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<main id="main-content" class="layout">
			<header class="hero">
				<div class="hero__banner">
					<img src="/Assets/banner_clean.png" alt="Pixel art of a developer working at a desk with dual monitors." />
				</div>
				<div class="hero__text">
					<p class="hero__eyebrow">Accessibility-first apps &amp; tools</p>
					<h1 class="hero__title">Blind Pixels Studio</h1>
					<p class="hero__subtitle">
						We craft indie software that makes cursors, interfaces, and rules easier to see and understand for everyone.
					</p>
					<div class="hero__actions">
						<a class="support-button" href="https://buymeacoffee.com/blindpixels" rel="noopener" target="_blank">
							<span class="support-button__icon" aria-hidden="true">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M18.5 8H5.5l-0.7 4.2C4.5 13.8 5.4 15 6.7 15h7.6c1.3 0 2.4-1.2 1.9-2.8L16 10h2c1.1 0 2-0.9 2-2s-0.9-2-2-2H5" stroke="#f8fafc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									<path d="M15.5 17c0 1.7-1.3 3-3 3s-3-1.3-3-3" stroke="#f8fafc" stroke-width="1.5" stroke-linecap="round" />
								</svg>
							</span>
							<span class="support-button__label">Support me</span>
						</a>
					</div>
				</div>
			</header>
			<section class="about" aria-labelledby="about-heading">
				<h2 id="about-heading">About the studio</h2>
				<p>
					Blind Pixels Studio is an indie shop focused on accessibility-first software.
					We build small, opinionated tools that make digital spaces easier to see,
					teach, and share—starting with cursors, interfaces, and game rules.
				</p>
			</section>
			<section class="apps" aria-labelledby="apps-heading">
				<h2 id="apps-heading">Apps &amp; Tools</h2>
				<div class="apps__grid">
					{apps.map((app) => (
						<article class="app-card" id={app.id}>
							<h3>{app.title}</h3>
							<p>{app.description}</p>
							<div class="app-card__actions">
								<a class="app-card__primary" href={app.primary.href}>{app.primary.label}</a>
								<a class="app-card__secondary" href={app.secondary.href}>{app.secondary.label}</a>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<footer class="footer">
			<p>&copy; {currentYear} Blind Pixels Studio. All rights reserved.</p>
			<div class="footer__links" aria-label="Secondary navigation">
				<a href="/contact">Contact</a>
				<a href="#apps-heading">Apps</a>
				<a href="/privacy">Privacy</a>
			</div>
		</footer>
	</body>
	<style lang="css">
		:root {
			color-scheme: dark;
			font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
			background-color: #07090f;
			color: #f1f5ff;
		}

		* {
			box-sizing: border-box;
		}

		body.page {
			margin: 0;
			min-height: 100svh;
			display: flex;
			flex-direction: column;
			background: radial-gradient(circle at top left, #14213d 0%, #07090f 60%);
		}

		.skip-link {
			position: absolute;
			left: 50%;
			transform: translate(-50%, -200%);
			padding: 0.6rem 1rem;
			background: #f1f5ff;
			color: #111827;
			text-decoration: none;
			border-radius: 999px;
			transition: transform 0.2s ease;
			z-index: 10;
		}

		.skip-link:focus {
			transform: translate(-50%, 20%);
		}

		.layout {
			width: min(1080px, 100% - 3rem);
			margin: 0 auto;
			padding: 4rem 0 6.25rem;
		}

		.hero {
			display: grid;
			gap: 3rem;
			align-items: center;
		}

		.hero__banner {
			position: relative;
			border-radius: 24px;
			overflow: hidden;
			background: radial-gradient(circle at top, rgba(20, 33, 61, 0.6), rgba(7, 9, 15, 1));
			box-shadow: 0 18px 45px rgba(10, 14, 33, 0.45);
			aspect-ratio: 21 / 9;
		}

		.hero__banner img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero__text {
			text-align: center;
			max-width: 540px;
			margin: 0 auto;
			display: grid;
			gap: 1.25rem;
		}

		.hero__eyebrow {
			font-size: 0.9rem;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: rgba(209, 215, 255, 0.65);
			margin-bottom: 0.75rem;
		}

		.hero__title {
			margin: 0;
			font-size: clamp(2.75rem, 5vw, 3.75rem);
			letter-spacing: -0.02em;
			color: #f8fafc;
		}

		.hero__subtitle {
			margin: 1rem 0 0;
			font-size: 1.1rem;
			line-height: 1.6;
			color: rgba(229, 235, 255, 0.72);
		}

		.about {
			margin-top: 4rem;
			padding: 2.5rem 2.25rem;
			border-radius: 24px;
			background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.9));
			border: 1px solid rgba(148, 163, 209, 0.2);
			box-shadow: 0 18px 35px rgba(7, 10, 22, 0.5);
		}

		.about h2 {
			margin-top: 0;
			margin-bottom: 0.75rem;
			font-size: 1.6rem;
		}

		.about p {
			margin: 0;
			max-width: 54ch;
			font-size: 1rem;
			line-height: 1.7;
			color: rgba(226, 232, 255, 0.9);
		}

		.hero__actions {
			display: flex;
			justify-content: center;
		}

		.support-button {
			display: inline-flex;
			align-items: center;
			gap: 0.65rem;
			padding: 0.75rem 1.4rem;
			border-radius: 999px;
			background: linear-gradient(120deg, #fbbf24, #f97316);
			color: #0f172a;
			text-decoration: none;
			font-weight: 700;
			box-shadow: 0 12px 25px rgba(249, 115, 22, 0.35);
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.support-button:hover,
		.support-button:focus {
			transform: translateY(-2px);
			box-shadow: 0 16px 30px rgba(249, 115, 22, 0.5);
		}

		.support-button__icon svg {
			display: block;
		}

		.support-button__label {
			font-size: 1rem;
		}

		.apps {
			margin-top: 5rem;
		}

		.apps h2 {
			font-size: clamp(2rem, 4vw, 2.6rem);
			margin-bottom: 2rem;
			text-align: center;
		}

		.apps__grid {
			display: grid;
			gap: 1.8rem;
			grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		}

		.app-card {
			padding: 1.8rem;
			border-radius: 20px;
			background: linear-gradient(180deg, rgba(15, 23, 42, 0.9), rgba(10, 15, 29, 0.95));
			border: 1px solid rgba(148, 163, 209, 0.18);
			box-shadow: 0 18px 35px rgba(7, 10, 22, 0.4);
			display: flex;
			flex-direction: column;
			gap: 1rem;
			transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		}

		.app-card:hover,
		.app-card:focus-within {
			transform: translateY(-6px);
			box-shadow: 0 26px 40px rgba(7, 10, 22, 0.55);
			border-color: rgba(148, 163, 209, 0.4);
		}

		.app-card h3 {
			margin: 0;
			font-size: 1.5rem;
			color: #f8fafc;
		}

		.app-card p {
			margin: 0;
			font-size: 1rem;
			line-height: 1.6;
			color: rgba(226, 232, 255, 0.8);
			flex: 1;
		}

		.app-card__actions {
			display: flex;
			gap: 0.9rem;
			align-items: center;
			flex-wrap: wrap;
		}

		.app-card__primary {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.55rem 1.2rem;
			border-radius: 999px;
			background: rgba(59, 130, 246, 0.95);
			color: #eff6ff;
			text-decoration: none;
			font-weight: 600;
			font-size: 0.95rem;
		}

		.app-card__primary:hover,
		.app-card__primary:focus {
			background: rgba(37, 99, 235, 1);
		}

		.app-card__secondary {
			font-size: 0.9rem;
			color: rgba(191, 219, 254, 0.9);
			text-decoration: none;
		}

		.app-card__secondary:hover,
		.app-card__secondary:focus {
			text-decoration: underline;
		}

		.footer {
			margin-top: auto;
			padding: 2.5rem 1.5rem;
			text-align: center;
			color: rgba(207, 214, 255, 0.55);
			font-size: 0.9rem;
			border-top: 1px solid rgba(30, 64, 175, 0.35);
		}

		.footer__links {
			margin-top: 0.5rem;
			display: flex;
			justify-content: center;
			gap: 1.25rem;
			flex-wrap: wrap;
		}

		.footer__links a {
			color: rgba(191, 219, 254, 0.85);
			text-decoration: none;
		}

		.footer__links a:hover,
		.footer__links a:focus {
			text-decoration: underline;
		}

		@media (min-width: 960px) {
			.hero {
				grid-template-columns: 1fr 1fr;
			}

			.hero__text {
				text-align: left;
				margin: 0;
				justify-items: start;
			}

			.hero__actions {
				justify-content: flex-start;
			}
		}

		@media (max-width: 640px) {
			.layout {
				padding: 3rem 0 5.25rem;
				width: min(100%, 100% - 2.5rem);
			}

			.hero__banner {
				order: -1;
			}
		}
	</style>
</html>
