---
import apps from "../data/apps.json";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const isNativeStoreLink = (href: string) =>
	href.includes("play.google.com") || href.includes("apps.apple.com");
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon_16.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="I like to make apps and tools that help people with low vision. Like me." />
		<title>Blind Pixels Studio – Accessibility-first apps &amp; tools</title>
		
		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Blind Pixels Studio – Accessibility-first apps &amp; tools" />
		<meta property="og:description" content="I like to make apps and tools that help people with low vision. Like me. Built by a low-vision developer." />
		<meta property="og:image" content="/Assets/banner_clean.png" />
		<meta property="og:url" content="https://blindpixelsstudio.com" />
		
	</head>
	<body class="page">
		<Nav isHome />
		<main id="main-content" class="layout" tabindex="-1">
			<header class="hero">
				<div class="hero__text">
					<p class="hero__eyebrow">Accessibility-first apps &amp; tools</p>
					<h1 class="hero__title">I like to make apps and tools that help people with low vision. Like me.</h1>
					<p class="hero__subtitle">
						Built by a low-vision developer, for anyone who struggles to follow cursors, tiny UI, or dense rulebooks.
					</p>
					<div class="hero__actions">
						<a class="support-button" href="https://buymeacoffee.com/blindpixels" rel="noopener noreferrer" target="_blank">
							<span class="support-button__icon" aria-hidden="true">
								<img src="/Assets/coffeeCup.png" alt="" width="22" height="22" />
							</span>
							<span class="support-button__label">Support the studio<span class="sr-only"> (opens in a new tab)</span></span>
						</a>
					</div>
					<p class="hero__donation-note">Donations help fund free accessibility tools.</p>
				</div>
				<div class="hero__image">
					<img src="/Assets/sideview.png" alt="Pixel art of a developer working at a desk with dual monitors." />
				</div>
			</header>
			<section id="about" class="about" aria-labelledby="about-heading">
				<div class="about__content">
					<h2 id="about-heading">About the studio</h2>
					<p>
						Blind Pixels Studio is a one-person indie shop building accessibility-first software 
						that makes digital experiences easier for everyone—especially low-vision users, educators, 
						gamers, and remote teams.
					</p>
					<p>
						Every tool I create is born from real frustrations: struggling to follow tiny cursors 
						in screen-shares, squinting at complex board game rulebooks, or missing important details 
						in recorded tutorials. We design small, focused solutions that solve real problems.
					</p>

				</div>
				<div class="about__image">
					<img src="/Assets/banner_clean.png" alt="Blind Pixels Studio banner showing the studio's pixel art branding." />
				</div>
			</section>
			<section id="apps" class="apps" aria-labelledby="apps-heading">
				<div class="apps__heading">
					<p class="apps__eyebrow">What I build</p>
					<h2 id="apps-heading">Apps &amp; tools</h2>
				</div>
				<div class="apps__grid">
					{apps.map((app) => (
						<article class="app-card" id={app.id}>
							<div class="app-card__header">
								{app.icon ? (
									<img class="app-card__icon" src={app.icon} alt="" width="56" height="56" loading="lazy" />
								) : (
									<span class="app-card__icon app-card__icon--fallback" aria-hidden="true">RR</span>
								)}
								<div class="app-card__heading-copy">
									<div class="app-card__meta">
										<span class="app-card__platform">{app.platform}</span>
										{app.status && (
											<span class:list={["app-card__status", {
												"app-card__status--beta": app.status === "Beta",
												"app-card__status--planned": app.status === "Coming soon",
											}]}>{app.status}</span>
										)}
										{app.comingSoon && <span class="app-card__badge">Coming soon</span>}
									</div>
									<h3 class="app-card__title">{app.title}</h3>
								</div>
							</div>
							{app.tagline && <p class="app-card__tagline">{app.tagline}</p>}
							<div class="app-card__actions">
								<a
									class:list={["app-card__primary", { "app-card__store-link": isNativeStoreLink(app.primary.href) }]}
									href={app.primary.href}
									target={app.primary.href.startsWith("http") ? "_blank" : undefined}
									rel={app.primary.href.startsWith("http") ? "noopener noreferrer" : undefined}
								>
									{app.primary.href.includes("play.google.com") && (
										<svg class="app-card__store-icon" viewBox="0 0 24 24" aria-hidden="true">
											<path fill="#34a853" d="M2.6 3.2c-.4.4-.6 1-.6 1.8v14c0 .8.2 1.4.6 1.8L13.9 10 2.6 3.2Z" />
											<path fill="#4285f4" d="m14.8 10.5-3.1-1.9L2.6 3.2c.4-.4 1-.5 1.7-.1l12.3 7.1-1.8.3Z" />
											<path fill="#fbbc04" d="m14.8 13.5 1.8.3L4.3 20.9c-.7.4-1.3.3-1.7-.1l9.1-5.4 3.1-1.9Z" />
											<path fill="#ea4335" d="m16.6 10.3 3.8 2.2c1 .6 1 1.6 0 2.2l-3.8 2.2-1.8-3.4 1.8-3.2Z" />
										</svg>
									)}
									{app.primary.label}
									{app.primary.href.startsWith("http") && <span class="sr-only"> (opens in a new tab)</span>}
								</a>
								{app.store && (
									<a class="app-card__store-link" href={app.store.href} target="_blank" rel="noopener noreferrer">
										<svg class="app-card__store-icon app-card__store-icon--apple" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M17.1 12.8c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.6-1.7-3.2-1.7-1.4-.1-2.8.8-3.5.8-.7 0-1.8-.8-2.9-.8-1.5 0-2.9.9-3.7 2.3-1.6 2.8-.4 6.9 1.1 9.2.8 1.1 1.6 2.4 2.8 2.3 1.1 0 1.5-.7 2.9-.7s1.8.7 2.9.7c1.2 0 1.9-1.1 2.7-2.3.9-1.3 1.3-2.7 1.3-2.8-.1 0-2.3-.9-2.3-3.6ZM14.8 6.2c.6-.8 1-1.9.9-3-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.8-1 2.9 1 0 2-.5 2.7-1.2Z" />
										</svg>
										{app.store.label}<span class="sr-only"> (opens in a new tab)</span>
									</a>
								)}
								{app.tertiary && (
									<a class="app-card__tertiary" href={app.tertiary.href}>{app.tertiary.label}</a>
								)}
							</div>
						</article>
					))}
				</div>
			</section>
			<section id="support" class="support" aria-labelledby="support-heading">
				<h2 id="support-heading">Support the studio</h2>
				<p>
					Your support helps keep our accessibility tools free and accessible to everyone who needs them. 
					Donations fund hosting costs, development time, testing with real users, and shipping new features 
					that make cursors, interfaces, and rules easier to see and understand.
				</p>
				<p>
					Every contribution—no matter the size—helps us continue building tools that make digital spaces 
					more accessible for people with low vision, educators, gamers, and teams everywhere.
				</p>
				<div class="support__actions">
					<a class="support-cta" href="https://buymeacoffee.com/blindpixels" rel="noopener noreferrer" target="_blank">
						<span class="support-cta__icon" aria-hidden="true">
							<img src="/Assets/coffeeCup.png" alt="" width="24" height="24" />
						</span>
					<span class="support-cta__text">
						<span class="support-cta__label">Support the studio</span>
						<span class="support-cta__sublabel">Buy me a coffee<span class="sr-only"> (opens in a new tab)</span></span>
					</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
	<style lang="css">
		.layout {
			width: min(1080px, 100% - 3rem);
			margin: 0 auto;
			padding: 4rem 0 6.25rem;
		}

		.hero {
			display: grid;
			gap: 3rem;
			align-items: center;
			justify-items: center;
			text-align: center;
			padding: 3rem 0;
		}

		.hero__image {
			display: none;
		}

		.hero__banner {
			position: relative;
			border-radius: 24px;
			overflow: hidden;
			background: radial-gradient(circle at top, rgba(20, 33, 61, 0.6), rgba(7, 9, 15, 1));
			box-shadow: 0 18px 45px rgba(10, 14, 33, 0.45);
			aspect-ratio: 21 / 9;
		}

		.hero__banner img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hero__text {
			text-align: center;
			max-width: 540px;
			margin: 0 auto;
			display: grid;
			gap: 1.25rem;
		}

		.hero__eyebrow {
			font-size: 0.9rem;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: rgba(209, 215, 255, 0.82);
			margin-bottom: 0.75rem;
		}

		.hero__title {
			margin: 0;
			font-size: clamp(1.75rem, 4vw, 2.5rem);
			letter-spacing: -0.02em;
			color: #f8fafc;
			line-height: 1.2;
		}

		.hero__subtitle {
			margin: 1rem 0 0;
			font-size: 1.1rem;
			line-height: 1.6;
			color: rgba(229, 235, 255, 0.85);
		}

		.about {
			margin-top: 4rem;
			padding: 2.5rem 2.25rem;
			border-radius: 24px;
			background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.9));
			border: 1px solid rgba(148, 163, 209, 0.2);
			box-shadow: 0 18px 35px rgba(7, 10, 22, 0.5);
			scroll-margin-top: 5rem;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.about__content {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.about__image {
			position: relative;
			border-radius: 16px;
			overflow: hidden;
			background: radial-gradient(circle at top, rgba(20, 33, 61, 0.6), rgba(7, 9, 15, 1));
			box-shadow: 0 12px 30px rgba(10, 14, 33, 0.45);
		}

		.about__image img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.about h2 {
			margin-top: 0;
			margin-bottom: 0.75rem;
			font-size: 1.6rem;
		}

		.about p {
			margin: 0;
			max-width: 100%;
			font-size: 1rem;
			line-height: 1.7;
			color: rgba(226, 232, 255, 0.9);
		}

		.about p + p {
			margin-top: 1rem;
		}

		.hero__actions {
			display: flex;
			justify-content: center;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.primary-cta {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.875rem 1.8rem;
			border-radius: 999px;
			background: linear-gradient(135deg, #3b82f6, #2563eb);
			color: #ffffff;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.05rem;
			box-shadow: 0 12px 25px rgba(59, 130, 246, 0.4);
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.primary-cta:hover,
		.primary-cta:focus {
			transform: translateY(-2px);
			box-shadow: 0 16px 30px rgba(59, 130, 246, 0.6);
		}

		.primary-cta:focus-visible {
			outline: 3px solid #93c5fd;
			outline-offset: 4px;
		}

		.hero__donation-note {
			margin-top: 0.75rem;
			font-size: 0.875rem;
			color: rgba(209, 215, 255, 0.82);
			text-align: center;
		}

		.support-button {
			display: inline-flex;
			align-items: center;
			gap: 0.65rem;
			padding: 0.75rem 1.4rem;
			border-radius: 999px;
			background: linear-gradient(120deg, #fbbf24, #f97316);
			color: #0f172a;
			text-decoration: none;
			font-weight: 700;
			box-shadow: 0 12px 25px rgba(249, 115, 22, 0.35);
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.support-button:hover,
		.support-button:focus {
			transform: translateY(-2px);
			box-shadow: 0 16px 30px rgba(249, 115, 22, 0.5);
		}

		.support-button:focus-visible {
			outline: 3px solid #fbbf24;
			outline-offset: 4px;
		}

		.support-button__icon img {
			display: block;
		}

		.support-button__label {
			font-size: 1rem;
		}

		.apps {
			margin-top: 5rem;
			scroll-margin-top: 5rem;
		}

		.apps__heading {
			margin-bottom: 2rem;
		}

		.apps__eyebrow {
			margin: 0 0 0.45rem;
			color: #67e8f9;
			font-size: 0.78rem;
			font-weight: 700;
			text-align: center;
			text-transform: uppercase;
			letter-spacing: 0.14em;
		}

		.apps h2 {
			font-size: clamp(2rem, 4vw, 2.6rem);
			margin: 0;
			text-align: center;
		}

		.apps__grid {
			display: grid;
			gap: 1.25rem;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.app-card {
			position: relative;
			overflow: hidden;
			padding: 1.5rem;
			border-radius: 8px;
			background: rgba(9, 15, 28, 0.88);
			border: 1px solid rgba(148, 163, 184, 0.2);
			box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);
			display: flex;
			flex-direction: column;
			gap: 1.15rem;
			transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		}

		.app-card::before {
			content: "";
			position: absolute;
			inset: 0 auto 0 0;
			width: 3px;
			background: #22d3ee;
			opacity: 0.7;
		}

		.app-card:hover,
		.app-card:focus-within {
			transform: translateY(-3px);
			box-shadow: 0 20px 36px rgba(0, 0, 0, 0.32);
			border-color: rgba(103, 232, 249, 0.45);
		}

		.app-card h3 {
			margin: 0;
			font-size: 1.35rem;
			color: #f8fafc;
		}

		.app-card__header {
			display: grid;
			grid-template-columns: 56px minmax(0, 1fr);
			align-items: center;
			gap: 0.9rem;
			min-height: 56px;
		}

		.app-card__icon {
			display: block;
			width: 56px;
			height: 56px;
			border-radius: 12px;
			object-fit: cover;
			box-shadow: 0 6px 16px rgba(0, 0, 0, 0.28);
		}

		.app-card__icon--fallback {
			display: grid;
			place-items: center;
			background: #172033;
			border: 1px solid rgba(103, 232, 249, 0.35);
			color: #a5f3fc;
			font-size: 0.9rem;
			font-weight: 800;
			letter-spacing: 0.08em;
		}

		.app-card__heading-copy {
			display: grid;
			gap: 0.55rem;
			min-width: 0;
		}

		.app-card__title {
			margin: 0;
		}

		.app-card__meta {
			display: flex;
			gap: 0.65rem;
			flex-wrap: wrap;
			align-items: center;
		}

		.app-card__badge {
			display: inline-block;
			padding: 0.25rem 0.65rem;
			border-radius: 999px;
			background: rgba(251, 191, 36, 0.2);
			border: 1px solid rgba(251, 191, 36, 0.4);
			color: #fbbf24;
			font-size: 0.8125rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.app-card__platform {
			color: #a5f3fc;
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
		}

		.app-card__status {
			display: inline-flex;
			align-items: center;
			padding: 0.18rem 0.5rem;
			border-radius: 999px;
			background: rgba(34, 197, 94, 0.15);
			border: 1px solid rgba(34, 197, 94, 0.3);
			color: #86efac;
			font-size: 0.75rem;
			font-weight: 600;
		}

		.app-card__status--beta {
			background: rgba(14, 165, 233, 0.15);
			border-color: rgba(14, 165, 233, 0.35);
			color: #7dd3fc;
		}

		.app-card__status--planned {
			background: rgba(245, 158, 11, 0.14);
			border-color: rgba(245, 158, 11, 0.35);
			color: #fcd34d;
		}

		.app-card__tagline {
			margin: 0;
			font-size: 0.98rem;
			font-weight: 500;
			line-height: 1.6;
			color: rgba(226, 232, 240, 0.78);
		}

		.app-card__for-who {
			margin: 0;
			font-size: 0.875rem;
			line-height: 1.5;
			color: rgba(209, 215, 255, 0.7);
			font-style: italic;
		}

		.app-card p {
			margin: 0;
			font-size: 1rem;
			line-height: 1.6;
			color: rgba(226, 232, 255, 0.8);
			flex: 1;
		}

		.app-card__actions {
			display: grid;
			gap: 0.5rem;
			margin-top: auto;
			padding-top: 0.5rem;
		}

		.app-card__primary {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 44px;
			padding: 0.65rem 1rem;
			border-radius: 8px;
			background: #0f766e;
			border: 1px solid #0f766e;
			color: #f8fafc;
			text-decoration: none;
			font-weight: 600;
			font-size: 0.875rem;
			transition: all 0.2s ease;
		}

		.app-card__store-icon {
			width: 1.25rem;
			height: 1.25rem;
			flex: 0 0 auto;
			margin-right: 0.55rem;
		}

		.app-card__store-icon--apple {
			fill: currentColor;
		}

		.app-card__primary:hover,
		.app-card__primary:focus {
			background: #0e7169;
			border-color: #0e7169;
			color: #f8fafc;
		}

		.app-card__store-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 44px;
			padding: 0.65rem 1rem;
			border-radius: 8px;
			background: transparent;
			border: 1px solid rgba(103, 232, 249, 0.48);
			color: #cffafe;
			text-decoration: none;
			font-size: 0.875rem;
			font-weight: 600;
			transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		}

		.app-card__store-link:hover,
		.app-card__store-link:focus {
			background: rgba(34, 211, 238, 0.1);
			border-color: #67e8f9;
			color: #ecfeff;
		}

		.app-card__primary--disabled {
			background: rgba(71, 85, 105, 0.5);
			color: rgba(148, 163, 184, 0.7);
			cursor: not-allowed;
		}

		.app-card__primary--disabled:hover,
		.app-card__primary--disabled:focus {
			background: rgba(71, 85, 105, 0.5);
		}

		.app-card__secondary {
			justify-content: center;
			font-size: 0.875rem;
			color: rgba(203, 213, 225, 0.95);
			text-decoration: none;
			transition: color 0.2s ease;
			padding: 0.25rem 0;
			min-height: 44px;
			display: inline-flex;
			align-items: center;
		}

		.app-card__secondary:has(.app-card__store-icon) {
			font-weight: 600;
		}

		.app-card__secondary:hover,
		.app-card__secondary:focus {
			color: rgba(226, 232, 240, 0.95);
			text-decoration: underline;
		}

		.app-card__tertiary {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-size: 0.875rem;
			color: #a5f3fc;
			text-decoration: none;
			transition: color 0.2s ease;
			padding: 0.25rem 0;
			min-height: 44px;
		}

		.app-card__tertiary:hover,
		.app-card__tertiary:focus {
			color: rgba(226, 232, 240, 0.9);
			text-decoration: underline;
		}

		@media (max-width: 860px) {
			.apps__grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		.support {
			margin-top: 5rem;
			padding: 3rem 2.5rem;
			border-radius: 24px;
			background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(249, 115, 22, 0.08) 100%);
			border: 1px solid rgba(251, 191, 36, 0.25);
			box-shadow: 0 18px 35px rgba(7, 10, 22, 0.5);
			text-align: center;
			scroll-margin-top: 5rem;
		}

		.support h2 {
			margin-top: 0;
			margin-bottom: 1.5rem;
			font-size: clamp(2rem, 4vw, 2.4rem);
