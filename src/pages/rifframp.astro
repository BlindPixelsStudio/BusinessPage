---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "RiffRamp – Blind Pixels Studio";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="RiffRamp is a riff-practice webapp focused on short musical passages, repetition quality, timing feedback, and measurable progress."
    />
  </head>
  <body class="page">
    <Nav />
    <main id="main-content" class="detail layout" aria-labelledby="rifframp-heading">
      <header class="detail__header">
        <p class="detail__eyebrow">Web app</p>
        <h1 id="rifframp-heading">RiffRamp</h1>
        <p class="detail__lede">
          A riff-practice webapp focused on short musical passages, repetition
          quality, timing feedback, and measurable progress.
        </p>
      </header>
      <section class="detail__section">
        <h2>Who it's for</h2>
        <p>
          Musicians who want to build muscle memory efficiently by drilling
          short passages with real-time feedback on their timing and consistency.
        </p>
      </section>
      <section class="detail__section">
        <h2>What it does</h2>
        <ul>
          <li>Breaks songs into short, focused riff passages for targeted practice.</li>
          <li>Tracks repetition quality so you know when a riff is truly learned.</li>
          <li>Provides timing feedback to tighten your rhythm.</li>
          <li>Measures progress over time so you can see improvement.</li>
        </ul>
      </section>
      <section class="detail__section">
        <h2>Status</h2>
        <p>
          Coming soon.
        </p>
      </section>
    </main>
    <Footer />
  </body>
  <style lang="css">
    .layout {
      width: min(960px, 100% - 3rem);
      margin: 0 auto;
      padding: 3.5rem 0 4rem;
    }

    .detail__header h1 {
      margin: 0;
      font-size: clamp(2.2rem, 4vw, 2.8rem);
    }

    .detail__eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.8rem;
      color: rgba(191, 219, 254, 0.8);
      margin-bottom: 0.75rem;
    }

    .detail__lede {
      margin-top: 1rem;
      font-size: 1.05rem;
      line-height: 1.7;
      color: rgba(226, 232, 255, 0.86);
    }

    .detail__section {
      margin-top: 2.5rem;
    }

    .detail__section h2 {
      margin-bottom: 0.75rem;
      font-size: 1.3rem;
    }

    .detail__section p,
    .detail__section li {
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(226, 232, 255, 0.9);
    }

    .detail__section ul {
      margin: 0;
      padding-left: 1.2rem;
    }
  </style>
</html>
