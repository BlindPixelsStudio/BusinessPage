---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Contact – Blind Pixels Studio";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Get in touch with Blind Pixels Studio about accessibility-focused apps and tools."
    />
  </head>
  <body class="page">
    <Nav />
    <main id="main-content" class="layout" aria-labelledby="contact-heading" tabindex="-1">
      <header class="contact__header">
        <h1 id="contact-heading">Contact</h1>
        <p>
          Have a question, idea, or accessibility request? Send a message using the
          form below.
        </p>
        <p class="contact__required-legend">
          Fields marked with an asterisk (<span class="required-mark" aria-hidden="true">*</span>) are required.
        </p>
      </header>
      <div
        id="form-errors"
        class="form-errors"
        role="alert"
        aria-live="assertive"
        tabindex="-1"
        hidden
      >
      </div>
      <form class="contact__form" method="post" action="/api/contact">
        <div class="field">
          <label for="name">Name <span class="required-mark" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error" />
          <p id="name-error" class="field__error" hidden></p>
        </div>
        <div class="field">
          <label for="email">Email <span class="required-mark" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            aria-describedby="email-error"
          />
          <p id="email-error" class="field__error" hidden></p>
        </div>
        <div class="field">
          <label for="subject">Subject <span class="required-mark" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
          <input
            id="subject"
            name="subject"
            type="text"
            autocomplete="off"
            required
            aria-describedby="subject-error"
          />
          <p id="subject-error" class="field__error" hidden></p>
        </div>
        <div class="field"> 
          <label for="message">Message <span class="required-mark" aria-hidden="true">*</span><span class="sr-only">(required)</span></label>
          <textarea id="message" name="message" rows="6" required aria-describedby="message-error"></textarea>
          <p id="message-error" class="field__error" hidden></p>
        </div>
        <button class="contact__submit" type="submit">Send message</button>
        <p class="contact__note">
          We use email via Resend to deliver your message. Please avoid including
          sensitive personal information.
        </p>
      </form>
    </main>
    <Footer />
    <script>
      const form = document.querySelector(".contact__form") as HTMLFormElement | null;
      const summary = document.getElementById("form-errors");

      if (form && summary) {
        // Disable native validation only when JS is available, so users
        // without JS still get built-in required-field validation.
        form.noValidate = true;
        const fields = Array.from(
          form.querySelectorAll("input, textarea")
        ) as (HTMLInputElement | HTMLTextAreaElement)[];

        const fieldName = (el: HTMLInputElement | HTMLTextAreaElement) => {
          const label = form.querySelector('label[for="' + el.id + '"]');
          if (!label || !label.textContent) return el.name;
          return label.textContent.replace("*", "").replace("(required)", "").trim();
        };

        const setError = (
          el: HTMLInputElement | HTMLTextAreaElement,
          message: string
        ) => {
          const error = document.getElementById(el.id + "-error");
          el.setAttribute("aria-invalid", "true");
          if (error) {
            error.textContent = message;
            error.hidden = false;
          }
        };

        const clearError = (el: HTMLInputElement | HTMLTextAreaElement) => {
          const error = document.getElementById(el.id + "-error");
          el.removeAttribute("aria-invalid");
          if (error) {
            error.textContent = "";
            error.hidden = true;
          }
        };

        fields.forEach((el) => {
          el.addEventListener("input", () => {
            if (el.checkValidity()) clearError(el);
          });
        });

        form.addEventListener("submit", (event) => {
          const invalid: { id: string; message: string }[] = [];
          fields.forEach((el) => {
            if (el.checkValidity()) {
              clearError(el);
            } else {
              const name = fieldName(el);
              const message = el.validity.valueMissing
                ? name + " is required."
                : "Please enter a valid " + name.toLowerCase() + ".";
              setError(el, message);
              invalid.push({ id: el.id, message });
            }
          });

          if (invalid.length === 0) {
            summary.hidden = true;
            return;
          }

          event.preventDefault();
          const heading =
            invalid.length === 1
              ? "Please fix the following error:"
              : "Please fix the following " + invalid.length + " errors:";
          const items = invalid
            .map((item) => '<li><a href="#' + item.id + '">' + item.message + "</a></li>")
            .join("");
          summary.innerHTML =
            '<p class="form-errors__title">' + heading + "</p><ul>" + items + "</ul>";
          summary.hidden = false;
          summary.focus();
        });
      }
    </script>
  </body>
  <style lang="css">
    .layout {
      width: min(720px, 100% - 3rem);
      margin: 0 auto;
      padding: 3.5rem 0 5rem;
    }

    .contact__header h1 {
      margin: 0 0 0.75rem;
      font-size: clamp(2.1rem, 4vw, 2.7rem);
    }

    .contact__header p {
      margin: 0;
      color: rgba(226, 232, 255, 0.86);
      line-height: 1.7;
    }

    .contact__form {
      margin-top: 2.5rem;
      padding: 2.25rem 2rem;
      border-radius: 20px;
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.92));
      border: 1px solid rgba(148, 163, 209, 0.35);
      box-shadow: 0 18px 35px rgba(7, 10, 22, 0.6);
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      margin-bottom: 1.4rem;
    }

    .field label {
      font-weight: 500;
      font-size: 0.95rem;
    }

    .field input,
    .field textarea {
      border-radius: 10px;
      border: 1px solid rgba(148, 163, 209, 0.5);
      padding: 0.65rem 0.85rem;
      font-size: 1rem;
      font-family: inherit;
      color: #e5e7eb;
      background: rgba(15, 23, 42, 0.9);
    }

    .field input:focus-visible,
    .field textarea:focus-visible {
      outline: 3px solid #60a5fa;
      outline-offset: 2px;
      border-color: transparent;
    }

    .field input[aria-invalid="true"],
    .field textarea[aria-invalid="true"] {
      border-color: #f87171;
    }

    .contact__submit {
      margin-top: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      border: none;
      background: linear-gradient(120deg, #4f46e5, #2563eb);
      color: #eff6ff;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      box-shadow: 0 12px 25px rgba(37, 99, 235, 0.5);
    }

    .contact__submit:hover,
    .contact__submit:focus {
      background: linear-gradient(120deg, #4338ca, #1d4ed8);
    }

    .contact__note {
      margin-top: 1rem;
      font-size: 0.9375rem;
      color: rgba(156, 163, 175, 0.95);
    }

    .contact__required-legend {
      margin-top: 0.75rem;
      font-size: 0.95rem;
      color: rgba(226, 232, 255, 0.86);
    }

    .required-mark {
      color: #fca5a5;
      font-weight: 700;
    }

    .form-errors {
      margin-top: 2rem;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      background: rgba(220, 38, 38, 0.12);
      border: 1px solid #f87171;
      color: #fecaca;
    }

    .form-errors__title {
      margin: 0 0 0.5rem;
      font-weight: 700;
      color: #fecaca;
    }

    .form-errors ul {
      margin: 0;
      padding-left: 1.2rem;
    }

    .form-errors a {
      color: #fecaca;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .field__error {
      margin: 0.35rem 0 0;
      font-size: 0.9rem;
      color: #fca5a5;
    }

    @media (max-width: 640px) {
      .layout {
        width: min(100%, 100% - 2.5rem);
        padding: 3rem 0 4.5rem;
      }

      .contact__form {
        padding: 1.8rem 1.5rem;
      }
    }
  </style>
</html>
