---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const pageTitle = "Video Cursor Tracker – Blind Pixels Studio";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Video Cursor Tracker is an accessibility browser extension that helps people with low vision follow cursors in screen-shares and videos."
    />
  </head>
  <body class="page">
    <Nav />
    <main id="main-content" class="detail layout" aria-labelledby="video-cursor-tracker-heading" tabindex="-1">
      <header class="detail__header">
        <p class="detail__eyebrow">Browser Extension</p>
        <h1 id="video-cursor-tracker-heading">Video Cursor Tracker</h1>
        <p class="detail__lede">
          An accessibility extension that helps people with low vision follow cursors in
          embedded web videos.
        </p>
      </header>
      <section class="detail__section">
        <h2>Who it's for</h2>
        <p>
          Video Cursor Tracker is for anyone who struggles to see the mouse cursor in web video tutorials—especially people with
          low vision or attention challenges.
        </p>
      </section>
      <section class="detail__section">
        <h2>What it does</h2>
        <ul>
          <li>Highlights the cursor with high-contrast visuals.</li>
          <li>Makes it easier to track mouse movement in web videos.</li>
          <li>Reduces eye strain by avoiding constant searching for the cursor.</li>
        </ul>
      </section>
      <section class="detail__section">
        <h2>Get the Web Extension</h2>
        <p>
          <a href="https://chromewebstore.google.com/detail/video-cursor-tracker/nhpcfocchlmbnpaplidmdhcejjjmjdoc?authuser=4&hl=en" target="_blank" rel="noopener noreferrer">Chrome Web Store<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      </section>
    </main>
    <Footer />
  </body>
  <style lang="css">
    .layout {
      width: min(960px, 100% - 3rem);
      margin: 0 auto;
      padding: 3.5rem 0 4rem;
    }

    .detail__header h1 {
      margin: 0;
      font-size: clamp(2.2rem, 4vw, 2.8rem);
    }

    .detail__eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.8rem;
      color: rgba(191, 219, 254, 0.8);
      margin-bottom: 0.75rem;
    }

    .detail__lede {
      margin-top: 1rem;
      font-size: 1.05rem;
      line-height: 1.7;
      color: rgba(226, 232, 255, 0.86);
    }

    .detail__section {
      margin-top: 2.5rem;
    }

    .detail__section h2 {
      margin-bottom: 0.75rem;
      font-size: 1.3rem;
    }

    .detail__section p,
    .detail__section li {
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(226, 232, 255, 0.9);
    }

    .detail__section ul {
      margin: 0;
      padding-left: 1.2rem;
    }
  </style>
</html>
